# ============================================
# SecureFlow — пример переменных окружения.
# Скопируй в .env и заполни. .env в .gitignore!
# ============================================

# --- Общие ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=SecureFlow

# --- PostgreSQL ---
POSTGRES_USER=secureflow
POSTGRES_PASSWORD=change_me_in_prod_strong_password
POSTGRES_DB=secureflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- JWT ---
SECRET_KEY=replace_me_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000